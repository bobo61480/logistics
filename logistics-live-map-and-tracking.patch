+/**
+ * Immediate single-row approve/reject, called from the dashboard's Gmail
+ * ingestion review card via doPost({ action: "reviewPending" }). Mirrors
+ * processApprovedPending()'s commit logic for one specific row instead of
+ * waiting for the 30-minute time-driven pass. Must be called from inside a
+ * caller-held LockService.getScriptLock() (doPost already holds it).
+ */
+function reviewPendingRow_(rowIndex, decision, correctedFields) {
+  var sheet = ensurePendingSheet_();
+  var lastRow = sheet.getLastRow();
+  var row = Number(rowIndex);
+  if (!Number.isInteger(row) || row < 2 || row > lastRow) {
+    throw new Error("Invalid pending review row.");
+  }
+  var col = {};
+  VALIDATION.pendingHeaders.forEach(function (h, i) { col[h] = i; });
+  var values = sheet.getRange(row, 1, 1, VALIDATION.pendingHeaders.length).getDisplayValues()[0];
+  var currentStatus = String(values[col["Status"]] || "").trim().toUpperCase();
+  if (currentStatus === "COMMITTED") throw new Error("This row was already committed.");
+  var rowRange = sheet.getRange(row, 1, 1, VALIDATION.pendingHeaders.length);
+
+  if (decision === "REJECTED") {
+    sheet.getRange(row, col["Status"] + 1).setValue("REJECTED");
+    rowRange.setBackground(VALIDATION.colors.rejected).setFontColor("#999999");
+    return { row: row, status: "REJECTED" };
+  }
+  if (decision !== "APPROVED") throw new Error("Decision must be APPROVED or REJECTED.");
+
+  var record;
+  try { record = JSON.parse(values[col["Raw JSON"]] || "{}"); }
+  catch (e) { record = {}; }
+  var fields = correctedFields || {};
+  record.customer = fields.customer || values[col["Customer"]] || record.customer;
+  record.invoice = fields.invoice || values[col["Invoice / PI"]] || record.invoice;
+  record.pro = fields.pro || values[col["BL / PRO"]] || record.pro;
+  record.container = fields.container || values[col["Container"]] || record.container;
+  record.qty = fields.qty || values[col["Qty"]] || record.qty;
+  record.note = fields.note || values[col["Note"]] || record.note;
+  var when = fields.shipDate || values[col["Ship Date / ETA"]];
+  var kind = String(values[col["Kind"]] || "outbound").toLowerCase();
+  if (kind === "inbound") { record.eta = when || record.eta; }
+  else { record.shipDate = when || record.shipDate; }
+
+  var result = kind === "inbound" ? upsertInboundEmailV2_(record, true) : upsertOutboundEmailV2_(record, true);
+  if (!result || (!result.matched && result.action !== "inserted")) {
+    throw new Error("Could not commit this record to the schedule. It may need manual correction first.");
+  }
+
+  sheet.getRange(row, col["Status"] + 1).setValue("COMMITTED");
+  rowRange.setBackground(VALIDATION.colors.committed);
+  return {
+    row: row,
+    status: "COMMITTED",
+    kind: kind,
+    action: result.action,
+    driveFolder: record._driveFolder || values[col["Drive File"]] || ""
+  };
+}
