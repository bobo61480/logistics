+function pendingReviewItems(table: any): PendingReviewItem[] {
+  if (!table?.rows) return [];
+  const find = inventoryIndexes(table);
+  const indexes = {
+    kind: find("KIND"),
+    status: find("STATUS"),
+    issues: find("ISSUES"),
+    customer: find("CUSTOMER"),
+    invoice: find("INVOICE / PI"),
+    pro: find("BL / PRO"),
+    container: find("CONTAINER"),
+    shipDate: find("SHIP DATE / ETA"),
+    qty: find("QTY"),
+    carrier: find("CARRIER / VESSEL"),
+    note: find("NOTE"),
+    sourceEmail: find("SOURCE EMAIL"),
+    driveFile: find("DRIVE FILE"),
+  };
+  return table.rows.flatMap((row: any, rowIndex: number) => {
+    const value = (index: number) => (index >= 0 ? cell(row, index) : "");
+    const status = value(indexes.status).trim().toUpperCase();
+    if (status !== "NEEDS REVIEW") return [];
+    return [{
+      id: `pending-review-${rowIndex}`,
